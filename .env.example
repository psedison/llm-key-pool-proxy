# ==========================================================================
# llm-key-pool-proxy 配置文件
# ==========================================================================
# 用法：复制本文件为 .env（与 proxy_server.py 同目录）后修改。
#   - 生效优先级：系统环境变量 > .env 文件 > 代码内置默认值
#   - 所有项都有默认值；注释掉的行 = 使用默认值，需要改就取消注释
#   - Key 推荐放 keys.txt（每行一个 key|上游地址）；也可用下方 KEYPOOL_KEYS
#   - 修改后重启代理生效；启动日志会打印所有生效值，可用来核对
# ==========================================================================

# --------------------------------------------------------------------------
# 监听：代理对下游暴露的地址
# --------------------------------------------------------------------------
# 下游工具（DSH / OpenAI SDK 等）的 Base URL 填：
#   http://<可达的本机IP>:<PROXY_PORT>/<前缀>
# 例：http://127.0.0.1:8787/api/plan/v3
#
# PROXY_HOST=0.0.0.0     监听所有网卡（局域网内其他机器也能访问）；改 127.0.0.1 则仅本机可用
# PROXY_PORT=8787

# --------------------------------------------------------------------------
# Key 池：账号凭据，每把 Key 绑定它自己的上游地址
# --------------------------------------------------------------------------
# 推荐方式：keys.txt 文件，每行一个（行序 = priority 优先级 = rotation 轮换顺序）：
#   key|https://ark.cn-beijing.volces.com/api/plan/v3
# 地址必须写到服务完整前缀（含 /api/plan/v3、/v1 这类路径），转发时以它为准。
# 或用本变量注入（逗号分隔，优先于 keys.txt）：
#
# KEYPOOL_KEYS=key1|https://上游A,key2|https://上游B
# KEYS_FILE=keys.txt

# --------------------------------------------------------------------------
# 选 Key 策略：决定一次请求该用池里的哪把 Key
# --------------------------------------------------------------------------
# priority （默认）独享池推荐：永远用第一把可用 Key，失败才换下一把。
#   优点：流量固定在一个账号，上游上下文缓存持续命中，token 花费最低
#   缺点：会把第一把 Key 的配额用到打满才换人——多人共用时后面的人没得用
# rotation 共享池推荐：窗口轮换（详见下方 rotation 窗口段），额度均摊到所有账号
# round_robin 逐请求轮换：每个请求都换账号，上游缓存全失效（输入 token 全价），不推荐
# random 随机：每次请求在当前可用 Key 里等概率挑一把（无状态、可能连续撞同一把，
#   长期分布趋近均匀）。缓存表现与 round_robin 一样差，且负载短期不均匀——
#   仅在需要"不可预测的账号切换模式"时才有意义，一般不建议选
#
# KEY_PICK_STRATEGY=priority

# --------------------------------------------------------------------------
# rotation 窗口（仅 KEY_PICK_STRATEGY=rotation 时生效）
# --------------------------------------------------------------------------
# 原理：所有流量集中在"活跃 Key"上，以下三个条件任一满足，就切换到下一把
# 可用 Key（按 keys.txt 顺序，自动跳过冷却/禁用中的），窗口重新计时：
#   ROTATION_WINDOW_TOKENS    窗口内累计消耗的 token（in+out）达到阈值。
#                             推荐主触发器——与上游配额计量同口径，额度均摊最准
#   ROTATION_WINDOW_REQUESTS  窗口内累计请求数达到阈值
#   ROTATION_WINDOW_SECONDS   当前 Key 连续服务时长（秒）达到阈值
# 例：500 万 token 或 100 个请求或 30 分钟，先到先切
# 设 0 关闭该触发器；三个全 0 时 rotation 无法启动
#
# ROTATION_WINDOW_TOKENS=5000000
# ROTATION_WINDOW_REQUESTS=100
# ROTATION_WINDOW_SECONDS=1800

# --------------------------------------------------------------------------
# 失败冷却：Key 请求失败后的"临时休息"机制
# --------------------------------------------------------------------------
# 原理：某把 Key 请求失败后，代理让它"冷却"一段时间，期间选 Key 会跳过它；
# 冷却结束自动回到池里，无需人工干预。
# 冷却时长 = 对应基数 × 指数退避（同一把 Key 连续失败时翻倍：60→120→240→…），
# 封顶 = KEY_COOLDOWN_MAX_SECONDS，防止无休止拉长。
#
# KEY_COOLDOWN_SECONDS
#   通用失败基数：上游 5xx 故障等。例：设 60 → 第 1 次失败歇 60s，
#   连续第 2 次 120s，第 3 次 240s……恢复后自动清零
#
# KEY_QUOTA_COOLDOWN_SECONDS
#   配额失败基数：额度打满且报文"没有"给重置时间时使用。
#   注意：火山周配额报文自带 "reset at 2026-09-21 00:00:00" 这样的时刻，
#   此时直接精确冷却到该时刻，本值不参与；只有报文无时间时才按本值退避
#
# KEY_RATELIMIT_COOLDOWN_SECONDS
#   频率限流基数：请求太频繁类（"Requests are too frequent"，几秒即恢复）。
#   例：设 5 → 歇 5s、10s、20s……
#
# KEY_COOLDOWN_MAX_SECONDS
#   退避封顶：无论连续失败多少次，单次冷却不超过此值（默认 1 小时）
#
# KEY_MAX_CONSECUTIVE_FAILS
#   禁用阈值：只统计 401/403（Key 无效）这类失败，连续 N 次禁用该 Key
#   （禁用后需 POST /pool/recover 恢复，或改 keys.txt 重启）。
#   配额/限流/5xx/网络失败永远不会触发禁用——它们不是 Key 的错
#
# 另两类特殊失败（无参数可调，行为固定）：
#   网络连不上（断网/DNS 失败）→ 不算任何 Key 的失败，直接换下一把重试
#   模型/服务不匹配（404 UnsupportedModel，如 plan 模型打到 coding Key）
#     → 不冷却，换下一把 Key 用它自己的地址重试
#
# KEY_COOLDOWN_SECONDS=60
# KEY_QUOTA_COOLDOWN_SECONDS=120
# KEY_RATELIMIT_COOLDOWN_SECONDS=5
# KEY_COOLDOWN_MAX_SECONDS=3600
# KEY_MAX_CONSECUTIVE_FAILS=3

# --------------------------------------------------------------------------
# 转发行为
# --------------------------------------------------------------------------
# UPSTREAM_PATH_PREFIXES
#   代理对外暴露的路径前缀（逗号分隔）。这只是代理自己的"门牌"命名空间：
#   下游请求路径中匹配到的前缀会被剥掉，剩余的端点后缀拼到"选中 Key 自己
#   的地址"后面——真正去哪个上游、走哪个路径，完全由 Key 绑定的地址决定。
#   例：下游调 http://127.0.0.1:8787/api/plan/v3/chat/completions
#     → 剥掉前缀 /api/plan/v3 → 选中 Key 地址 + /chat/completions
#   想自定义暴露前缀（比如 /myapi）就把它加进列表，否则该前缀的请求返回 404
#
# UPSTREAM_TIMEOUT_SECONDS
#   非流式请求等待上游响应的最长时间；流式请求的连接 + 首包超时
#
# STREAM_READ_TIMEOUT_SECONDS
#   流式（SSE）请求相邻数据块之间的最大等待——深度推理模型两个数据块
#   之间可能停顿数十秒，别设太小
#
# UPSTREAM_PATH_PREFIXES=/api/plan/v3,/api/v3,/v3,/v1
# UPSTREAM_TIMEOUT_SECONDS=600
# STREAM_READ_TIMEOUT_SECONDS=300

# --------------------------------------------------------------------------
# 日志
# --------------------------------------------------------------------------
# LOG_LEVEL=INFO           DEBUG 最详细；WARNING 只看问题
# LOG_FILE=logs/proxy.log  设置后日志同时写入文件（按天轮转，保留 14 天），
#                          控制台输出不变；用 run-guarded 守护脚本时会自动设置
#
# LOG_LEVEL=INFO
# LOG_FILE=logs/proxy.log
