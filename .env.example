# llm-key-pool-proxy 配置模板
# 用法：复制本文件为 .env 后修改（.env 已被 .gitignore 排除，不会上传）。
# 优先级：系统环境变量 > .env 文件 > 内置默认值。所有项都有默认值，按需取消注释。
# Key 的存放：推荐 keys.txt（每行一个 key|base_url）；也可用下方 KEYPOOL_KEYS。

# ---- 监听 ----
# PROXY_HOST=0.0.0.0
# PROXY_PORT=8787

# ---- Key 池 ----
# KEYPOOL_KEYS=key1|https://ark.cn-beijing.volces.com/api/plan/v3,key2|https://api.deepseek.com/v1
# KEYS_FILE=keys.txt

# ---- 选 Key 策略 ----
# priority（默认）：固定用第一把可用 Key，缓存最友好，适合独享池
# rotation：窗口轮换，适合多人共用池——额度均摊，避免盯死一把用到废
# KEY_PICK_STRATEGY=priority

# rotation 三个窗口触发器，先到先切；至少一个 > 0；0=关闭该触发器
# ROTATION_WINDOW_TOKENS=5000000     活跃 Key 窗口内累计 in+out token 阈值（主触发，与配额计量同口径）
# ROTATION_WINDOW_REQUESTS=100       活跃 Key 窗口内请求数阈值
# ROTATION_WINDOW_SECONDS=1800       活跃 Key 窗口时长阈值（秒，如 1800=30 分钟）

# ---- 失败冷却 ----
# KEY_COOLDOWN_SECONDS=60            通用失败冷却基数（指数退避）
# KEY_QUOTA_COOLDOWN_SECONDS=120     配额类冷却基数（报文带 reset 时间则精确冷却）
# KEY_RATELIMIT_COOLDOWN_SECONDS=5   频率限流冷却基数
# KEY_COOLDOWN_MAX_SECONDS=3600      冷却封顶
# KEY_MAX_CONSECUTIVE_FAILS=3        连续 auth 失败禁用阈值

# ---- 转发 ----
# UPSTREAM_PATH_PREFIXES=/api/plan/v3,/api/v3,/v3,/v1   对外暴露的路径前缀（命名空间，可自定义）
# UPSTREAM_TIMEOUT_SECONDS=600
# STREAM_READ_TIMEOUT_SECONDS=300

# ---- 日志 ----
# LOG_LEVEL=INFO
# LOG_FILE=logs/proxy.log            设置后日志同时落盘（按天轮转，保留 14 天）
